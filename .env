# Safe example configuration. Copy to .env and replace placeholders before live use.
MODE=paper
DRY_RUN=true
REAL_TRADING_ENABLED=false
SHADOW_TRADING_ENABLED=true

# Credentials (placeholders are intentionally unusable)
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_USER_ID=123456789
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_WALLET_ADDRESS=your_wallet_address_here

# Capital safety
AUTHORIZED_CAPITAL_USD=0
BTC_BANKROLL_ALLOCATION=1.0
ETH_BANKROLL_ALLOCATION=1.0
SOL_BANKROLL_ALLOCATION=1.0
XRP_BANKROLL_ALLOCATION=1.0
TEST_STOP_LOSS_BALANCE=0.5

# Execution guard defaults
MARKET_BUY_SLIPPAGE=0.035
EXECUTION_GUARD_SLIPPAGE_CAP=0.035
QUALITY_MAX_PRICE_IMPACT=0.035
EXECUTION_GUARD_PRICE_JUMP_CAP=0.025
TARGET_SPREAD_MAX=0.06
REALTIME_ORDERBOOK_ENABLED=true

# Strategies
STRATEGY_WHITELIST=barrier_reclaim,breakout,mean_reversion
BARRIER_RECLAIM_ENABLED=true
BARRIER_RECLAIM_USE_CUSTOM_QUALITY_GATE=true
BARRIER_RECLAIM_DEEP_AMBUSH_ENABLED=true
BARRIER_RECLAIM_DEEP_AMBUSH_MIN_TOKEN_PRICE=0.05
BARRIER_RECLAIM_DEEP_AMBUSH_MAX_TOKEN_PRICE=0.19

# Profit rule / learning safety
PROFIT_RULE_LIVE_REQUIRE_PROMOTE=true
PROFIT_RULE_MIN_ENTRY_PRICE=0.08
PROFIT_RULE_MAX_ENTRY_PRICE=0.75
PROFIT_RULE_MAX_MODEL_GAP=0.50
PROFIT_RULE_DEFAULT_HIGH_PROB=0.75
PROFIT_RULE_NEW_RULE_CAN_SHADOW=true
PROFIT_RULE_NEW_RULE_REQUIRES_ADAPTIVE_EDGE=true
PROFIT_RULE_NEW_RULE_MIN_ADAPTIVE_EV=0.08
PROFIT_RULE_NEW_RULE_MIN_ADAPTIVE_QUALITY=0.56
CLOB_V2_SIG3_REAL_SUBMIT_ENABLED=false
POLYMARKET_REPLAY_ON_START=false
