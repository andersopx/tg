# Safe high-win-rate profile template.
# Copy to .env, fill credentials, then run apply_high_win_rate_mode.sh if desired.
MODE=small_live
DRY_RUN=true
REAL_TRADING_ENABLED=false
OBSERVER_ONLY=false
SHADOW_TRADING_ENABLED=true
CLOB_V2_SIG3_REAL_SUBMIT_ENABLED=false
POLYMARKET_REPLAY_ON_START=false
REFERENCE_PRICE_SOURCE=polymarket_gamma
PRICE_TO_BEAT_FALLBACK_ENABLED=false
SHADOW_SETTLEMENT_EXTERNAL_FALLBACK_ENABLED=false
ENABLE_TELEGRAM=false
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_USER_ID=123456789
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0
STORE_API_CREDS=false
HIGH_WIN_RATE_MODE=true
TARGET_WIN_RATE=0.75
HIGH_WIN_RATE_MIN_MODEL_PROB=0.74
HIGH_WIN_RATE_UNKNOWN_STRATEGY_MIN_MODEL_PROB=0.78
HIGH_WIN_RATE_MIN_EDGE_AFTER_FEES=0.035
HIGH_WIN_RATE_USE_SHADOW_STATS=true
PROFIT_RULE_ENGINE_ENABLED=true
PROFIT_RULE_LIVE_REQUIRE_PROMOTE=true
PROFIT_RULE_MIN_PROMOTE_WIN_RATE=0.70
WINRATE_GOVERNOR_ENABLED=true
DAILY_PROFIT_LOCK_ENABLED=true
BACKTEST_REQUIRED_BEFORE_LIVE=true
BACKTEST_MIN_WIN_RATE=0.60
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY=0
MAX_ORDER_ATTEMPTS_PER_DAY=0
MIN_MARKET_ORDER_USD=1.0
